# ============================================
# SocaSob Frontend Environment Configuration
# ============================================

# Socket.io Server URL (REQUIRED)
# Format: http://hostname:port atau https://hostname
# 
# For Development (local backend):
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# For Production (cloud backend):
# NEXT_PUBLIC_SOCKET_URL=https://api.socasob.com

# For Staging:
# NEXT_PUBLIC_SOCKET_URL=https://staging-api.socasob.com

# ============================================
# Optional: API Gateway Configuration
# ============================================

# REST API Base URL (if different from Socket.io)
# Default: same as NEXT_PUBLIC_SOCKET_URL
# NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ============================================
# Optional: Feature Flags
# ============================================

# Enable/disable real-time Socket.io updates
# NEXT_PUBLIC_ENABLE_SOCKET=true

# Enable/disable mock data (for testing)
# NEXT_PUBLIC_USE_MOCK_DATA=false

# Enable/disable browser notifications
# NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# ============================================
# Optional: Analytics & Monitoring
# ============================================

# Sentry error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://...

# Google Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-...

# ============================================
# Notes
# ============================================
# - NEXT_PUBLIC_* variables are exposed to browser
# - Do NOT put sensitive tokens in NEXT_PUBLIC_*
# - Keep actual passwords/tokens in .env.local (not committed)
# - Copy this file to .env.local and fill in actual values
# - Development: most features work with localhost URLs
# - Production: must use HTTPS for Socket.io and API
